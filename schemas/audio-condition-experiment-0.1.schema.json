{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AB772K/VoxRigor/blob/main/schemas/audio-condition-experiment-0.1.schema.json",
  "title": "VoxRigor audio-condition experiment 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_manifest",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "source_manifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "target": {
            "enum": [
              "audio",
              "probe",
              "enrollment",
              "both"
            ],
            "default": "probe"
          },
          "transforms": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "target_sample_rate_hz"
                  ],
                  "properties": {
                    "kind": {
                      "const": "resample"
                    },
                    "target_sample_rate_hz": {
                      "type": "integer",
                      "minimum": 8000,
                      "maximum": 192000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "snr_db",
                    "seed"
                  ],
                  "properties": {
                    "kind": {
                      "const": "gaussian_noise"
                    },
                    "snr_db": {
                      "type": "number",
                      "minimum": -20,
                      "maximum": 80
                    },
                    "seed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "mulaw"
                    },
                    "sample_rate_hz": {
                      "const": 8000,
                      "default": 8000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "impulse_response"
                  ],
                  "properties": {
                    "kind": {
                      "const": "reverberation"
                    },
                    "impulse_response": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "wet_mix": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 0.35
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "description": "Runtime validation requires one clean scenario with no transforms. PAD scenarios target audio; ASV scenarios target probe, enrollment or both."
}
