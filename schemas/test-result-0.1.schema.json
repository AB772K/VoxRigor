{
  "$defs": {
    "ResultStatus": {
      "description": "A deliberately explicit result vocabulary.",
      "enum": [
        "vulnerable",
        "no_issue_observed",
        "inconclusive",
        "unsupported",
        "execution_error"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "SampleAccounting": {
      "additionalProperties": false,
      "description": "Reconciled sample counts for a test that consumes sample records.",
      "properties": {
        "input": {
          "default": 0,
          "minimum": 0,
          "title": "Input",
          "type": "integer"
        },
        "evaluated": {
          "default": 0,
          "minimum": 0,
          "title": "Evaluated",
          "type": "integer"
        },
        "excluded": {
          "default": 0,
          "minimum": 0,
          "title": "Excluded",
          "type": "integer"
        }
      },
      "title": "SampleAccounting",
      "type": "object"
    },
    "TestDescriptor": {
      "additionalProperties": false,
      "description": "Public metadata for a registered test; does not contain executable code.",
      "properties": {
        "test_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,79}$",
          "title": "Test Id",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[.-][a-zA-Z0-9.-]+)?$",
          "title": "Version",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "category": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "version",
        "name",
        "category",
        "description"
      ],
      "title": "TestDescriptor",
      "type": "object"
    },
    "TestError": {
      "additionalProperties": false,
      "description": "Sanitized exception metadata; tracebacks are not written to reports.",
      "properties": {
        "error_type": {
          "title": "Error Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "error_type",
        "message"
      ],
      "title": "TestError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One test execution result in the common report envelope.",
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "test": {
      "$ref": "#/$defs/TestDescriptor"
    },
    "status": {
      "$ref": "#/$defs/ResultStatus"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "measurements": {
      "additionalProperties": true,
      "title": "Measurements",
      "type": "object"
    },
    "sample_accounting": {
      "$ref": "#/$defs/SampleAccounting"
    },
    "evidence": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Evidence",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/TestError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "test",
    "status",
    "started_at",
    "finished_at"
  ],
  "title": "TestResult",
  "type": "object",
  "$id": "https://github.com/AB772K/VoxRigor/blob/main/schemas/test-result-0.1.schema.json"
}
