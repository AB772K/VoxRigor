{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxrigor.example/schemas/plugin-config-0.1.schema.json",
  "title": "VoxRigor Explicit Plugin Allow-list",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enabled_plugins"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "enabled_plugins": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plugin_id"],
        "properties": {
          "plugin_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "granted_permissions": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "enum": [
                "audio.read",
                "filesystem.read",
                "filesystem.write",
                "model.load",
                "network.loopback"
              ]
            }
          }
        }
      }
    }
  }
}
